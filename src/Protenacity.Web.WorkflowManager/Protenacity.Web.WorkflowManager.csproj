<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<StaticWebAssetBasePath>/</StaticWebAssetBasePath>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<!-- Umbraco 17 -->
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="[10.0.8,11)" />
		<PackageReference Include="Umbraco.Workflow.Core" Version="[17.2.0,21.0.0)" />
		<PackageReference Include="ZiggyCreatures.FusionCache" Version="2.5.0" />
	</ItemGroup>
</Project>
