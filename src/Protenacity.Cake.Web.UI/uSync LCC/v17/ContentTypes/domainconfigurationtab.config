<ContentType Key="f4545908-5002-40f5-af1a-dd0089ca8a27" Alias="domainConfigurationTab" Level="2">
  <Info>
    <Name>Domain Configuration Tab</Name>
    <Icon>icon-settings color-lime</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>Values that change website functionality</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Nothing</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>Furniture</Folder>
    <Compositions />
    <DefaultTemplate></DefaultTemplate>
    <AllowedTemplates />
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>698b3fd1-de25-4707-9720-68aaed0a605f</Key>
      <Name>Side Panel Left Width</Name>
      <Alias>configAsideLeftWidth</Alias>
      <Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition>
      <Type>Umbraco.Integer</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Pick a number between 1 and 12. Each consecutive number makes the side panel 8% wider.
1 = side panel takes up <span style="font-size: 70%; vertical-align: 0.7ex;">1</span>&frasl;<span style="font-size: 70%; vertical-align: -0.3ex;">12</span><sup>th</sup> of the page leaving <span style="font-size: 70%; vertical-align: 0.7ex;">11</span>&frasl;<span style="font-size: 70%; vertical-align: -0.3ex;">12</span><sup>th</sup> for main content. 
3 = side panel takes up <span style="font-size: 70%; vertical-align: 0.7ex;">3</span>&frasl;<span style="font-size: 70%; vertical-align: -0.3ex;">12</span><sup>th</sup> of the page leaving <span style="font-size: 70%; vertical-align: 0.7ex;">9</span>&frasl;<span style="font-size: 70%; vertical-align: -0.3ex;">12</span><sup>th</sup> for main content.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="config/aside">Aside</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>49d74527-609a-4a6b-9dcb-b61c663982de</Key>
      <Name>Side Panel Right Width</Name>
      <Alias>configAsideRightWidth</Alias>
      <Definition>2e6d3631-066e-44b8-aec4-96f09099b2b5</Definition>
      <Type>Umbraco.Integer</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Pick a number between 1 and 12. Each consecutive number makes the side panel 8% wider.
2 = side panel takes up <span style="font-size: 70%; vertical-align: 0.7ex;">2</span>&frasl;<span style="font-size: 70%; vertical-align: -0.3ex;">12</span><sup>th</sup> of the page leaving <span style="font-size: 70%; vertical-align: 0.7ex;">10</span>&frasl;<span style="font-size: 70%; vertical-align: -0.3ex;">12</span><sup>th</sup> for main content. 
4 = side panel takes up <span style="font-size: 70%; vertical-align: 0.7ex;">4</span>&frasl;<span style="font-size: 70%; vertical-align: -0.3ex;">12</span><sup>th</sup> of the page leaving <span style="font-size: 70%; vertical-align: 0.7ex;">8</span>&frasl;<span style="font-size: 70%; vertical-align: -0.3ex;">12</span><sup>th</sup> for main content.]]></Description>
      <SortOrder>2</SortOrder>
      <Tab Alias="config/aside">Aside</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
