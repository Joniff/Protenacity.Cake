    <GenericProperty>
      <Key>4686673a-1a7f-4719-a15b-cdd665499fd4</Key>
      <Name>Fuzziness</Name>
      <Alias>configSearchFuzziness</Alias>
      <Definition>5aba26ad-48e9-4859-a2e5-7592fb32f228</Definition>
      <Type>Umbraco.Integer</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Required similarity between search query and matching results. 
90 = Close matching only, 1 or 2 characters difference.
50 = Only half the characters are required to match. 

Lower the value more matches but slower the search takes to execute. If value is too low, search query will match everything.
]]></Description>
      <SortOrder>9</SortOrder>
      <Tab Alias="config/search">Search</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
