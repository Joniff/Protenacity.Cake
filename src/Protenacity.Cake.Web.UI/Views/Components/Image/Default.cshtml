@model Protenacity.Cake.Web.Presentation.Editor.Image.ImageViewModel

<div class="d-flex">
    @if (Model.FullScreen == true)
    {
        @:<a href="@Model.Image.Url()" data-toggle="lightbox">
    }

    <div class="d-block w-100 mb-2">
        @(await Component.InvokeAsync(ResponsiveImageViewComponent.Name, new ResponsiveImage
        {
            Image = Model.Image,
            ImageCrop = EditorImageCrops.Full,
            WidthFactorImage = 100
        }))
    </div>

    @if (Model.FullScreen == true)
    {
        @:</a>
    }
</div>
