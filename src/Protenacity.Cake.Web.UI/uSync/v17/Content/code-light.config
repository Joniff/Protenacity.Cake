                    {
                      "alias": "code",
                      "culture": null,
                      "editorAlias": null,
                      "segment": null,
                      "value": "import { LitElement, PropertyValueMap, css, customElement, html, property } from \u0027@umbraco-cms/backoffice/external/lit\u0027;\n\nfunction debounced(delay: number, fn: (...args: any) =\u003E void) {\n    let timerId: number | null;\n    return function (...args: any[]) {\n        if (timerId) {\n            clearTimeout(timerId);\n        }\n        timerId = setTimeout(() =\u003E { fn(...args); timerId = null }, delay)\n    }\n}\n"
                    }
                  ]
                }
