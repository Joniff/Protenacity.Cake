                      "editorAlias": null,
                      "segment": null,
                      "value": [
                        "Razor"
                      ]
                    },
                    {
                      "alias": "code",
                      "culture": null,
                      "editorAlias": null,
                      "segment": null,
                      "value": "@model Protenacity.Cake.Web.Presentation.Editor.Text.TextBlockCodeViewModel\n@using Protenacity.Cake.Web.Core.Extensions\n\n@{\n\n    @* https://github.com/highlightjs/highlight.js/blob/main/SUPPORTED_LANGUAGES.md *@\n\n    string? language = null;\n    switch (Model.Language)\n    {\n        case EditorCodeLanguage.Cpp:\n            language = \u0022cpp\u0022;\n            break;\n\n        case EditorCodeLanguage.CSharp:\n            language = \u0022csharp\u0022;\n            break;\n\n        case EditorCodeLanguage.Javascript:\n            language = \u0022javascript\u0022;\n            break;\n\n        case EditorCodeLanguage.Css:\n            language = \u0022css\u0022;\n            break;\n\n        case EditorCodeLanguage.CommandLine:\n            language = \u0022powershell\u0022;\n            break;\n\n        case EditorCodeLanguage.Html:\n            language = \u0022html\u0022;\n            break;\n\n        case EditorCodeLanguage.Json:\n            language = \u0022javascript\u0022;\n            break;\n\n        case EditorCodeLanguage.Python:\n            language = \u0022python\u0022;\n            break;\n\n        case EditorCodeLanguage.Razor:\n            language = \u0022cshtml-razor\u0022;\n            break;\n\n        case EditorCodeLanguage.Scss:\n            language = \u0022scss\u0022;\n            break;\n\n        case EditorCodeLanguage.Sql:\n            language = \u0022sql\u0022;\n            break;\n\n        case EditorCodeLanguage.Typescript:\n            language = \u0022typescript\u0022;\n            break;\n\n        case EditorCodeLanguage.Dockerfile:\n            language = \u0022dockerfile\u0022;\n            break;\n\n        case EditorCodeLanguage.Markdown:\n            language = \u0022markdown\u0022;\n            break;\n    }\n}\n\n@if (Model.AddDependencyLibrary)\n{\n    \u003Cscript src=\u0022https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js\u0022\u003E\u003C/script\u003E\n    \u003Cscript\u003E\n        (function () {\n            var head = document.getElementsByTagName(\u0027HEAD\u0027)[0];  \n            var link = document.createElement(\u0027link\u0027); \n            link.rel = \u0027stylesheet\u0027;  \n            link.type = \u0027text/css\u0027; \n            link.href = \u0027https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/default.min.css\u0027;  \n            head.appendChild(link);\n\n            document.addEventListener(\u0027DOMContentLoaded\u0027, function (event) {\n                hljs.highlightAll();\n            });\n        })();\n    \u003C/script\u003E\n}\n\n@if (language != null \u0026\u0026 Model.AddDependencyLibraryLanguage)\n{\n    \u003Cscript src=\u0022https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/@(language).min.js\u0022\u003E\u003C/script\u003E\n}\n\n\u003Ctheme subtheme=\u0022Model.Subtheme\u0022 shade=\u0022Model.Shade\u0022 override=\u0022Model.OverrideColor\u0022\u003E\n\u003Cpre\u003E\u003Ccode class=\u0022@(language != null ? \u0022language-\u0022 \u002B language : null)\u0022\u003E@Html.Raw(Model.Text)\u003C/code\u003E\u003C/pre\u003E\n\u003C/theme\u003E\n"
                    }
                  ]
                }
              ],
