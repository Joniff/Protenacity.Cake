<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<CompressionEnabled>false</CompressionEnabled>
		<!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
	</PropertyGroup>
	<ItemGroup>
	  <Content Remove="Views\Components\Card\ResponsiveLeft.cshtml" />
	  <Content Remove="Views\Components\Card\ResponsiveRight.cshtml" />
	  <Content Remove="Views\Components\Ribbon\Default.cshtml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Umbraco.AI" Version="1.9.0" />
		<PackageReference Include="Umbraco.AI.Agent" Version="1.8.0" />
		<PackageReference Include="Umbraco.AI.Agent.Copilot" Version="1.0.0-alpha6" />
		<PackageReference Include="Umbraco.AI.Agent.Core" Version="1.8.0" />
		<PackageReference Include="Umbraco.AI.Agent.Persistence" Version="1.8.0" />
		<PackageReference Include="Umbraco.AI.Agent.Persistence.Sqlite" Version="1.8.0" />
		<PackageReference Include="Umbraco.AI.Agent.Persistence.SqlServer" Version="1.8.0" />
		<PackageReference Include="Umbraco.AI.Agent.Startup" Version="1.8.0" />
		<PackageReference Include="Umbraco.AI.Agent.Web" Version="1.8.0" />
		<PackageReference Include="Umbraco.AI.Agent.Web.StaticAssets" Version="1.8.0" />
		<PackageReference Include="Umbraco.AI.Anthropic" Version="1.3.0" />
		<PackageReference Include="Umbraco.Cms" Version="17.3.4" />
		<PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.3.4" />
		<PackageReference Include="uSync" Version="17.3.0" />
		<PackageReference Include="ZiggyCreatures.FusionCache" Version="2.6.0" />
		<PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
		<RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Protenacity.Cake.Web.Core\Protenacity.Cake.Web.Core.csproj" />
		<ProjectReference Include="..\Protenacity.Cake.Web.Presentation\Protenacity.Cake.Web.Presentation.csproj" />
		<ProjectReference Include="..\Protenacity.Web.GraphEmail\Protenacity.Web.GraphEmail.csproj" />
		<ProjectReference Include="..\Protenacity.Web.TipTapHeaders\Protenacity.Web.TipTapHeaders.csproj" />
		<ProjectReference Include="..\Protenacity.Web.UfmPercent\Protenacity.Web.UfmPercent.csproj" />
		<ProjectReference Include="..\Protenacity.Web.OpenStreetMap\Protenacity.Web.OpenStreetMap.csproj" />
		<ProjectReference Include="..\Protenacity.Web.RollbackPreview\Protenacity.Web.RollbackPreview.csproj" />
		<ProjectReference Include="..\Protenacity.Spreadsheet\Protenacity.Spreadsheet.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<!-- Razor files are needed for the backoffice to work correctly -->
		<CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
	</PropertyGroup>

	<!--
	<ItemGroup>
		<Folder Include="wwwroot\App_Plugins\Protenacity.TipTapHeaders\" />
	</ItemGroup>
	-->
	
	<PropertyGroup>
		<!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
		<RazorCompileOnBuild>false</RazorCompileOnBuild>
		<RazorCompileOnPublish>false</RazorCompileOnPublish>
	</PropertyGroup>
	
	<ItemGroup Condition="'$(DesignTimeBuild)' == 'true'">
		<!-- 
			The cohosting editor uses the Razor source generator for VS functionality, so we have to make sure
			it can see the .cshtml files.
		-->
		<AdditionalFiles Include="**\*.cshtml" />

		<!--
			Make sure the source generator knows where the project is, for computing target paths.
		-->
		<CompilerVisibleProperty Include="MSBuildProjectDirectory" />
	</ItemGroup>	

</Project>
